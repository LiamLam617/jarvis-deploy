{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-ingress",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-21",
  "account_id": "5ec21083745c46f56581948fe5767c64",
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis-control",
      "database_id": "de6dbcab-cc2b-4d71-9fa1-f6971cdb9df6",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "jarvis-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "jarvis-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "jarvis-dead-letter",
        "max_concurrency": 1,
        "retry_delay": 30
      }
    ]
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "jarvis-control",
        "database_id": "de6dbcab-cc2b-4d71-9fa1-f6971cdb9df6",
        "migrations_dir": "migrations"
      }
    ],
    "queues": {
      "producers": [
        {
          "binding": "JOBS",
          "queue": "jarvis-jobs"
        }
      ]
    },
    "vars": {
      "P03_DIAGNOSTICS": "1",
      "DISCORD_PUBLIC_KEY": "5dee4864e08f34bf6a33677237b2547eeb759cbf9fba25b57e1efecd6b97d601",
      "DISCORD_GUILD_ID": "1488116208426287247",
      "DISCORD_JARVIS_CHANNEL_ID": "1553710999444529233",
      "DISCORD_INBOX_CHANNEL_ID": "1553711115433938945",
      "DISCORD_ALLOWED_USER_ID": "249763790709719040",
      "DISCORD_APPLICATION_ID": "1511992826815053844",
      "P04_QUEUE_ONLY": "0",
      "BRIDGE_ENABLED": "1"
    },
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  },
  "vars": {
    "DISCORD_PUBLIC_KEY": "5dee4864e08f34bf6a33677237b2547eeb759cbf9fba25b57e1efecd6b97d601",
    "DISCORD_GUILD_ID": "1488116208426287247",
